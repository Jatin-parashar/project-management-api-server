# --- Database ---------------------------------------------------------
# Local Postgres instance, database names as created during setup.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/project_management_dev?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:5432/project_management_shadow?sslmode=disable"

# --- App ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m

# --- WebAuthn / Passkeys --------------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Project Management App"
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Cloudinary (task attachments) -----------------------------------------
# From your Cloudinary Dashboard: cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
